@page
@model CartModel
@{
    ViewData["Title"] = "购物车";
}
<h1>购物车</h1>
@if (Model.PlacedOrder is { } order)
{
    <div class="info">下单成功，订单号：<span data-testid="order-no">CS@(order.Id)</span></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error" data-testid="error-msg">@Model.Error</div>
}
@if (Model.Cart.IsEmpty)
{
    <p>购物车为空</p>
}
else
{
    <table class="cart">
        <thead>
        <tr><th>商品</th><th>单价</th><th>数量</th><th>小计</th></tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Cart.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>¥@item.Price.ToString("0.00")</td>
                <td>@item.Quantity</td>
                <td>¥@item.Subtotal.ToString("0.00")</td>
            </tr>
        }
        </tbody>
    </table>
    <p>原价合计：¥@Model.Cart.Subtotal.ToString("0.00")</p>
}
<p>应付金额：<span data-testid="cart-total">¥@Model.Total.ToString("0.00")</span></p>
<form method="post">
    <button type="submit" disabled="@Model.Cart.IsEmpty">提交订单</button>
</form>
