@page
@model CartModel
@{
    ViewData["Title"] = "购物车";
}
<h1>购物车</h1>
@if (Model.PlacedOrder is { } order)
{
    <div class="info">下单成功，订单号：<span data-testid="order-no">CS@(order.Id)</span></div>
}
@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="error" data-testid="error-msg">@Model.Error</div>
}
@if (Model.Cart.IsEmpty)
{
    <p>购物车为空</p>
}
else
{
    <ul class="cart">
        @foreach (var item in Model.Cart.Items)
        {
            <li>@item.Name × @item.Quantity　¥@item.Subtotal.ToString("0.00")</li>
        }
    </ul>
    <p>原价合计：¥@Model.Cart.Subtotal.ToString("0.00")</p>
}
<p>应付金额：<span data-testid="cart-total">¥@Model.Total.ToString("0.00")</span></p>
<form method="post">
    <button type="submit">下单</button>
</form>
