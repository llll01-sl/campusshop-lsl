@page
@model ProductsModel
@{
    ViewData["Title"] = "商品";
}
<h1>商品列表</h1>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="info" data-testid="message">@Model.Message</div>
}
<table>
    <thead>
    <tr><th>商品</th><th>单价</th><th>库存</th><th>数量</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model.Products)
    {
        <tr>
            <td>@p.Name</td>
            <td>¥@p.Price.ToString("0.00")</td>
            <td>@Model.Stock(p.Id)</td>
            <td colspan="2">
                <form method="post" class="inline">
                    <input type="hidden" name="productId" value="@p.Id" />
                    <input type="number" name="quantity" value="1" min="1" max="99" aria-label="数量" />
                    <button type="submit">加入购物车</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
